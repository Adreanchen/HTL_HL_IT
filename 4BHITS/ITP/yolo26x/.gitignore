# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
venv/
.venv/
env/

# Environment variables
.env
.env.local

# Ultralytics runs & Model weights
runs/
*.pt
!models/best.pt
*.engine
*.onnx

# Dataset label cache
*.cache

# Video and raw/generated dataset dumps (avoid uploading multi-GB files to git)
*.mp4
*.avi
*.mov
*.mkv
dataset/raw/*
!dataset/raw/.gitkeep
dataset/train/images/*
!dataset/train/images/.gitkeep
dataset/train/labels/*
!dataset/train/labels/.gitkeep
dataset/valid/images/*
!dataset/valid/images/.gitkeep
dataset/valid/labels/*
!dataset/valid/labels/.gitkeep
dataset/test/images/*
!dataset/test/images/.gitkeep
dataset/test/labels/*
!dataset/test/labels/.gitkeep

# Node dependencies & logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE / Editor files
.idea/
.vscode/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db
