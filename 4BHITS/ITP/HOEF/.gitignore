# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
venv/
.venv/
env/

# Environment variables
.env
.env.local

# Ultralytics runs & Model weights
runs/
*.pt
!models/best.pt
!best.pt

# Dataset label cache
*.cache

# Video and raw dataset dumps (avoid uploading multi-GB files to git)
*.mp4
*.avi
*.mov
*.mkv
dataset/raw/*
!dataset/raw/.gitkeep

# Node dependencies & logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE / Editor files
.idea/
.vscode/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db
